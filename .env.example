# Bastion demo environment. Copy to .env to override.
# Everything here is non-secret: no certs, no keys, no tokens.

BASTION_TRUST_DOMAIN=bastion.local
LOG_LEVEL=info

# Token and cert lifetimes. VAULT_KEY_TTL_SECONDS=10 is short on purpose so
# `demo-vault-rotation` can observe a rotation within the demo window.
BASTION_CERT_TTL_HOURS=168
BASTION_CA_TTL_DAYS=365
VAULT_KEY_TTL_SECONDS=10

# Ports published on the host (only edge's data port is meant to be reachable
# from a laptop; the rest of the stack is on internal networks).
EDGE_DATA_HOST_PORT=8080
